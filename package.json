{
  "name": "lause-ds-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build:tokens": "npm run build --workspace @lause-ds/tokens",
    "build:ui": "npm run build --workspace lause-ds",
    "build:manifest": "npm run build:manifest --workspace lause-ds-mcp",
    "build:mcp": "npm run build --workspace lause-ds-mcp",
    "build:site": "mkdir -p site && cp llms.txt components.manifest.json site/",
    "storybook": "npm run storybook --workspace lause-ds",
    "typecheck": "tsc -b packages/tokens && tsc -p packages/ui && tsc -p packages/mcp --noEmit && tsc -p netlify",
    "changeset": "changeset",
    "release": "npm run build:tokens && npm run build:ui && changeset publish"
  },
  "dependencies": {
    "lause-ds-mcp": "*"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@netlify/functions": "6.0.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
