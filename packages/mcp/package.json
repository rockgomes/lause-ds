{
  "name": "lause-ds-mcp",
  "version": "0.0.0",
  "description": "The Lause design system as an MCP server: tokens, components, usage rules, and a usage check.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rockgomes/lause-ds.git", "directory": "packages/mcp" },
  "bin": { "lause-ds-mcp": "./dist/stdio.js" },
  "exports": { ".": { "types": "./dist/server.d.ts", "default": "./dist/server.js" } },
